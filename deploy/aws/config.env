# 部署常量：账号里现有资源的 ID 和本方案的固定取值。
# 所有脚本都 source 这个文件；改这里就能改所有脚本的取值。
# 依据：docs/aws-ningxia-production-deployment-plan.md

export AWS_REGION=cn-northwest-1
export AWS_DEFAULT_REGION=$AWS_REGION
ACCOUNT_ID=015060879373

# 现有网络（默认 VPC 和 3 个默认子网，5.1 节）
VPC_ID=vpc-0ca92ebcce25cb3e4
SUBNET_A=subnet-009376e4c0557bd4e
SUBNET_B=subnet-06800077e29ec5a83
SUBNET_C=subnet-07924e85246f5fab0

# 现有入口（共用，不归本方案的栈管理，5.3 节）
DEV_ALB_SG=sg-0670ea7d6bd038071
INT_ALB_SG=sg-06bc98eb3585b640a
DEV_ALB_LISTENER_ARN=arn:aws-cn:elasticloadbalancing:cn-northwest-1:015060879373:listener/app/dev-alb/9f75a0a754596426/b988aac42841c8e7
INT_ALB_LISTENER_ARN=arn:aws-cn:elasticloadbalancing:cn-northwest-1:015060879373:listener/app/alb-internal/b8e0aff29dadd856/13678dd296830670
DEV_ALB_FULL_NAME=app/dev-alb/9f75a0a754596426
INT_ALB_FULL_NAME=app/alb-internal/b8e0aff29dadd856
WAF_ACL_NAME=acl
WAF_ACL_ID=33ef31e3-5e48-4dbb-80a5-3c50bd0f3534
GATEWAY_HOST=lingying-gateway.echojoy.cn

# 监听规则优先级（5.3 节）。新规则先以 NEW_RULE_PRIORITY 部署，此时排在旧网关
# 的整域名规则之后，不接流量；切换时把旧规则从 OLD_RULE_PRIORITY 挪到
# OLD_RULE_PARKED_PRIORITY，新规则即生效。两个 ALB 上这三个数都空闲或就是旧规则本身。
NEW_RULE_PRIORITY=30
OLD_RULE_PRIORITY=2
OLD_RULE_PARKED_PRIORITY=31

# 灵影调用的控制面入口：只在 VPC 内解析（scripts/private-dns.sh），只挂在 alb-internal 上，
# 只放行 /api/models* 和 /api/access-keys*。优先级在 alb-internal 上空闲即可，这个域名没有别的规则。
CONTROL_HOST=aigw-internal.echojoy.cn
CONTROL_RULE_PRIORITY=32

# 镜像（9.1 节）
REGISTRY=docker.echojoy.cn
REGISTRY_USER=admin
# 网关的镜像都放在独立目录 echojoy-gateway/ 下，不写共用的 library/，避免覆盖其他服务在用的标签。
GATEWAY_IMAGE_REPO=$REGISTRY/echojoy-gateway/ai-gateway
POSTGRES_IMAGE=$REGISTRY/echojoy-gateway/postgres:18-alpine
REDIS_IMAGE=$REGISTRY/echojoy-gateway/redis:7.4-alpine
# 同步的来源镜像。连不上 Docker Hub 时可用环境变量换成加速源，例如 docker.wwhy.games/postgres:18-alpine。
POSTGRES_SOURCE_IMAGE=${POSTGRES_SOURCE_IMAGE:-postgres:18-alpine}
REDIS_SOURCE_IMAGE=${REDIS_SOURCE_IMAGE:-redis:7.4-alpine}

# 密钥（9.2 节）
SSM_PREFIX=/echojoy-gateway/prod

# 数据层固定私有 IP（7.1、8.1 节）
REDIS_IP_A=172.31.15.11
REDIS_IP_B=172.31.31.11
REDIS_IP_C=172.31.47.11
PG_IP=172.31.15.21
PG_DB=gateway
PG_USER=gateway

# CloudFormation 栈
STACK_NETWORK=echojoy-gateway-network
STACK_DATA=echojoy-gateway-data
STACK_GATEWAY=echojoy-gateway-app
