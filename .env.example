# HTTP server
# HOST controls native process listening and the default Compose host publishing
# for both the main service and provider OAuth callback ports. Keep it on
# loopback unless external access is protected.
HOST=127.0.0.1
PORT=3001
# Timeouts are seconds; the Compose stop grace period uses a duration.
GRACEFUL_SHUTDOWN_TIMEOUT=10
CONTAINER_STOP_GRACE_PERIOD=15s
READ_TIMEOUT=60
IDLE_TIMEOUT=120

# Storage
# Empty DATABASE_DSN uses ${DATA_DIR}/gpt-load.db. Otherwise set a SQLite,
# MySQL, or PostgreSQL URL; container file paths must use mounted paths.
DATA_DIR=./data
DATABASE_DSN=

# Security
# Empty values use generated auth.key and encryption.key files in DATA_DIR.
# Back up encryption.key with the database; losing it makes credentials unreadable.
AUTH_KEY=
ENCRYPTION_KEY=

# Cluster mode (experimental)
# Setting REDIS_ADDRS enables multi-instance mode: control-plane changes made on
# one instance propagate to the others. Requires a PostgreSQL DATABASE_DSN and
# explicit AUTH_KEY / ENCRYPTION_KEY shared by every instance. AccessKey rate
# limits and cost limits, credential health, subscription refreshes, Responses
# continuation, and soft affinity are shared through Redis, so the load
# balancer needs no sticky sessions.
#
# The docker-compose.cluster.yml sample (nginx, 3 replicas, Redis Cluster,
# PostgreSQL) sets DATABASE_DSN, REDIS_ADDRS, and INSTANCE_ID itself and only
# needs AUTH_KEY, ENCRYPTION_KEY, and the password below:
#   docker compose -f docker-compose.cluster.yml up -d
# POSTGRES_PASSWORD=
#
# REDIS_ADDRS=redis-a:6379,redis-b:6379   # comma-separated; list every Cluster node
# REDIS_PASSWORD=
# REDIS_TLS=false
# REDIS_KEY_PREFIX=gl
# INSTANCE_ID=                            # defaults to <hostname>-<random>
# RESPONSE_BINDING_TTL=720h               # Responses ownership retention in Redis, at least 1m

# Startup proxy fallback; restart after changes.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.internal.example.com

# Logging
LOG_LEVEL=info
LOG_FORMAT=text

# Optional process override; omit to use the Models.dev setting (enabled by default).
# MODELS_DEV_AUTO_SYNC_ENABLED=true
