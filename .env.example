# HTTP server
# HOST controls the Compose host publishing address for both the main service
# and provider OAuth callback ports. Keep it on loopback unless external access
# is protected.
HOST=127.0.0.1
PORT=3001
# Timeouts are seconds; the Compose stop grace period uses a duration.
GRACEFUL_SHUTDOWN_TIMEOUT=10
CONTAINER_STOP_GRACE_PERIOD=15s
READ_TIMEOUT=60
IDLE_TIMEOUT=120

# Required secrets
# Every replica must share the same ENCRYPTION_KEY. Generate it with
# `openssl rand -hex 32`. ENCRYPTION_KEY encrypts channel credentials; back it
# up with PostgreSQL, because losing it makes stored credentials unreadable.
ENCRYPTION_KEY=

# Management UI sign-in (Casdoor OpenID Connect)
# PUBLIC_URL is the address browsers use to reach the gateway; Casdoor
# redirects back to <PUBLIC_URL>/auth/callback, and unsafe console requests
# must come from this origin, so write it exactly as browsers send Origin
# (no default port such as :443). OIDC_ISSUER must equal Casdoor's configured
# origin and is also the base URL of its API. The client ID and secret come
# from the Casdoor application; CASDOOR_ORGANIZATION names the organization
# whose groups are the gateway's teams.
PUBLIC_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
CASDOOR_ORGANIZATION=
# Password for the bundled PostgreSQL service.
POSTGRES_PASSWORD=

# Topology
# docker-compose.yml runs one replica with PostgreSQL and a single Redis node.
# docker-compose.cluster.yml runs several replicas behind nginx with a Redis
# Cluster:
#   docker compose -f docker-compose.cluster.yml up -d
# Both files set DATABASE_DSN and REDIS_ADDRS themselves. The optional overrides
# below tune shared state; REDIS_PASSWORD and REDIS_TLS apply only when the
# Compose file is pointed at an external Redis.
#
# REDIS_PASSWORD=
# REDIS_TLS=false
# REDIS_KEY_PREFIX=gl
# INSTANCE_ID=                            # defaults to <hostname>-<random>
# RESPONSE_BINDING_TTL=720h               # Responses ownership retention in Redis, at least 1m

# Startup proxy fallback; restart after changes.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.internal.example.com

# Logging
LOG_LEVEL=info
LOG_FORMAT=text

# Optional process override; omit to use the Models.dev setting (enabled by default).
# MODELS_DEV_AUTO_SYNC_ENABLED=true
